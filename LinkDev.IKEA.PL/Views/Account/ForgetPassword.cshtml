@using LinkDev.IKEA.PL.Controllers
@model ForgetPasswordViewModel
@{
	ViewData["Title"] = "ForgetPassword";
	Layout = "~/Views/Shared/_AuthLayout.cshtml";
}


<div class="main-agileinfo">
	<div class="agileits-top">
		<form asp-action="@nameof(AccountController.SendResetPasswordUrl)" method="post" asp-controller="Account">
			<div asp-validation-summary="ModelOnly"></div>
			<br />

			<input asp-for="Email" placeholder="Email" required="">
			<span asp-validation-for="Email"></span>
			<br />

			<input class="btn btn-success" type="submit" value="Submit" />
		</form>
		<p>Don you not have an Account? <a asp-action="SignUp"> Sign Up Now!</a></p>
	</div>
</div>

@section Validation {
	<partial name="_ValidationScriptsPartial" />
}