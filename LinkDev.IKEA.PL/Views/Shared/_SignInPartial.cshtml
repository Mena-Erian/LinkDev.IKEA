@using LinkDev.IKEA.DAL.Entities.Identity
@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav ms-auto">
	@if (SignInManager.IsSignedIn(User))
	{
		<li class="nav-item">

			@if (User.IsInRole("Admin"))
			{
				<span class="nav-link text-success d-flex justify-content-between g-2 ">
					<span class=" text-warning mx-2">
						<a class=" text-warning" asp-controller="User" asp-action="Index">Users</a>
					</span>
					<span class=" text-warning mx-2">
						<a class=" text-danger" asp-controller="Role" asp-action="Index">Roles</a>
					</span>
					<span class=" text-success mx-2">
						Role:	Admin
					</span>
				</span>

			}
			@if (User.IsInRole("Manager"))
			{
				<span class="nav-link text-success mx-2">
					Role:	Manager
				</span>
			}
			@if (User.IsInRole("User"))
			{
				<span class="nav-link text-success mx-2">
					Role:	User
				</span>
			}
		</li>
		<li class="nav-item">
			<a class="nav-link text-dark" asp-controller="Home" asp-action="Index" title="Manager">
				Hello
				@User.Identity?.Name
			</a>
			@* <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manager">Hello
				@User.Identity?.Name</a> *@
		</li>
		<li class="nav-item">
			<a class="nav-link text-danger" asp-controller="Account" asp-action="SignOut">Sign Out</a>
		</li>
	}
	else
	{
		<li class="nav-item">
			<a class="nav-link text-dark" asp-controller="Account" asp-action="SignIn">Sign In</a>
		</li>
		<li class="nav-item">
			<a class="nav-link text-dark" asp-controller="Account" asp-action="SignUp">Sign Up</a>
		</li>

	}
</ul>