@model UpdateDepartmentViewModel
@{
	ViewData["Title"] = "Update Department";
}

<h1>Update Department</h1>

<div class="container my-4">
	<div class="row justify-content-center">
		<div class="col-lg-12 col-xl-10">
			<!-- Main Card -->
			<div class="card border-0 shadow-lg rounded-4 overflow-hidden animate__animated animate__fadeInUp">
				<!-- Header with gradient background -->
				<div class="card-header text-white py-4 px-5"
					 style="
                        background: linear-gradient(
                            135deg,
                            #667eea 0%,
                            #764ba2 100%
                        );
                    ">
					<div class="d-flex align-items-center">
						<div class="bg-white bg-opacity-25 rounded-circle p-3 me-3">
							<i class="fas fa-edit fs-3"></i>
						</div>
						<div>
							<h3 class="mb-0 fw-bold">
								Update Department
							</h3>
							<p class="mb-0 opacity-75">
								Edit in department to optomize
								your organization
							</p>
						</div>
					</div>
				</div>

				<div class="card-body p-5">
					<form asp-action="/Edit" asp-controller="Department">
						 
						<div asp-validation-summary="All" class="text-danger"></div>
						
						<!-- Department ID -->
						<div class="mb-4">
							<p class="form-label fw-bold">
								<i class="fas fa-hashtag text-primary me-2"></i>Department ID: @Model.Id
							</p>
						</div>

						<!-- Department Name -->
						<div class="mb-4">
							<label asp-for="Name"
								   class="form-label fw-bold">
								<i class="fas fa-building text-success me-2"></i>Department Name
								<span class="text-danger">*</span>
							</label>
							<input type="text"
								   class="form-control"
								   asp-for="Name"
								   placeholder="Enter department name (e.g., Information Technology)"
								   required
								   maxlength="100" />
							<div class="invalid-feedback">
								Department name is required and
								must be between 2-100
								characters.
							</div>
							<span class="form-text "
								  asp-validation-for="Name">
							</span>
						</div>

						<!-- Department Code -->
						<div class="mb-4">
							<label asp-for="Code"
								   class="form-label fw-bold">
								<i class="fas fa-barcode text-warning me-2"></i>Department Code
								<span class="text-danger">*</span>
							</label>
							<input type="text"
								   class="form-control text-uppercase"
								   asp-for="Code"
								   placeholder="Enter department code (e.g., IT-001)"
								   required
								   maxlength="20"
								   pattern="[A-Z0-9\-]+" />
								 
							<span asp-validation-for="Code" class="form-text ">
							</span>
						</div>

						<!-- Department Description -->
						<div class="mb-4">
							<label asp-for="Description"
								   class="form-label fw-bold">
								<i class="fas fa-align-left text-info"></i>
								Department Description
								<span class="text-danger">*</span>
							</label>
							<input type="text"
								   class="form-control"
								   asp-for="Description"
								   placeholder="Enter department Description (e.g., this Department for...)"
								   minlength="10" />
							<div class="invalid-feedback">
								Please provide a valid
								department code (uppercase
								letters, numbers, and hyphens
								only).
							</div>

							<span class="form-text "
								  asp-validation-for="Description">
							</span>
						</div>

						<!-- Creation Date -->
						<div class="mb-4">
							<label asp-for="CreationDate"
								   class="form-label fw-bold">
								<i class="fas fa-calendar-plus text-danger me-2"></i>Creation Date
								<span class="text-danger">*</span>
							</label>
							<div class="input-group input-group-lg">
								<span class="input-group-text bg-light border-end-0">
									<i class="fas fa-calendar text-muted"></i>
								</span>
								<input asp-for="CreationDate" type="date" class="form-control" />
								<button class="btn btn-outline-secondary"
										type="button"
										id="setCurrentDate">
									<i class="fas fa-clock me-2"></i>Now
								</button>
								<div class="invalid-feedback">
									Please select a valid
									creation date and time.
								</div>
							</div>
							<span class="form-text "
								  asp-validation-for="CreationDate">
							</span>
						</div>

						<!-- Form Actions -->
						<div class="row mt-4 pt-4 border-top">
							<div class="col-12">
								<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
									<button asp-action="Index"
											type="button"
											class="btn btn-outline-secondary btn-lg">
										<i class="fas fa-times me-2"></i>Cancel
									</button>
									<div class="d-flex gap-2">
										<button type="reset"
												class="btn btn-outline-warning btn-lg">
											<i class="fas fa-redo me-2"></i>Reset
										</button>
										<button asp-action="Edit" type="submit" class="btn btn-warning btn-lg">
											<i class="fas fa-save me-2"></i>Update Department
										</button>
									</div>
								</div>
							</div>
						</div>
					</form>
				</div>
			</div>

			<!-- Help Card -->
			<div class="card border-0 bg-white shadow-sm mt-3 animate__animated animate__fadeInUp animate__delay-1s">
				<div class="card-body p-4">
					<h6 class="fw-bold text-primary mb-3">
						<i class="fas fa-question-circle me-2"></i>Need Help?
					</h6>
					<div class="row g-3">
						<div class="col-md-4">
							<div class="d-flex align-items-start">
								<i class="fas fa-book text-info me-2 mt-1"></i>
								<div>
									<small class="fw-bold d-block">Documentation</small>
									<small class="text-muted">View guides</small>
								</div>
							</div>
						</div>
						<div class="col-md-4">
							<div class="d-flex align-items-start">
								<i class="fas fa-headset text-success me-2 mt-1"></i>
								<div>
									<small class="fw-bold d-block">Support</small>
									<small class="text-muted">Get assistance</small>
								</div>
							</div>
						</div>
						<div class="col-md-4">
							<div class="d-flex align-items-start">
								<i class="fas fa-video text-danger me-2 mt-1"></i>
								<div>
									<small class="fw-bold d-block">Tutorial</small>
									<small class="text-muted">Watch video</small>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
