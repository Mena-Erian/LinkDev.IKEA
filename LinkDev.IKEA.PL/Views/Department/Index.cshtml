@model IEnumerable<DepartmentViewModel>

@{
	ViewData["Title"] = "Department";
}
@* //SearchForSequence in database *@
@if (!string.IsNullOrEmpty(TempData["Message"]?.ToString()))
{
	<div class="toast" role="alert" aria-live="assertive" aria-atomic="true">
		<div class="toast-header">
			@* <img src="..." class="rounded me-2" alt="..."> *@
			<strong class="me-auto">Bootstrap</strong>
			<small>11 mins ago</small>
			<button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
		</div>
		<div class="toast-body">
			@TempData["Message"]
		</div>
	</div>
}

<h1 class="mb-3">All Department</h1>

<br />
@if (Model.Any())
{
	<div class="container">
		<div class="table-container text-center">
			<table class="table custom-table table-striped">
				<thead>
					<tr>
						<th class="d-flex justify-content-center align-items-center">
							<div class="company-logo">
								<i class="fas fa-building"></i>
							</div>
							<span>@Html.DisplayNameFor(d => d.Code)</span>
						</th>
						@* <th scope="col">@Html.DisplayNameFor(d => d.Name)</th> *@
						<th class="text-start" scope="col">@nameof(DepartmentViewModel.Name)</th>
						<th scope="colgroup">@Html.DisplayNameFor(d => d.CreationDate)</th>
						<th scope="colgroup">More</th>
					</tr>
				</thead>
				<tbody>

					@foreach (var department in Model)
					{
						<tr>
							<td>
								<span>@department.Code</span>
							</td>
							<td class="text-start">
								<a asp-action="Details" asp-route-id="@department.Id" class="fw-bold text-decoration-none text-dark fs-6 text-start">@department.Name</a>
							</td>
							<td>@department.CreationDate</td>

							<td>
								<button id="buttonMoreListContainer"
										type="button"
										class="btn btn-link text-secondary p-0"
										data-bs-toggle="popover"
										data-bs-trigger="focus"
										data-bs-html="true"
										data-bs-content='
		            <div id="moreList" class="list-group">
		                <a href="/Department/Details/@department.Id"
		                   class="list-group-item list-group-item-action">
		                   <i class="fas fa-info-circle me-2"></i>Details
		                </a>
		                <a href="/Department/Edit/@department.Id"
		                   class="list-group-item list-group-item-action">
		                   <i class="fas fa-edit me-2"></i>Edit
		                </a>
		                <a class="list-group-item list-group-item-action text-danger deleteModalBtn"
		                   data-deptid="@department.Id"
		                   data-bs-toggle="modal"
		                   data-bs-target="#deleteDepartmentModal">
		                   <i class="fas fa-trash me-2"></i>Delete
		                </a>
		            </div>'>
		    ⋯
		</button>


							</td>
						</tr>
					}

					<!--Delete Modal-->
					<div class="modal fade" id="deleteDepartmentModal" tabindex="-1" aria-hidden="true">
						<div class="modal-dialog">
							<div class="modal-content">
								<div class="modal-header">
									<h5 class="modal-title">Delete Department</h5>
									<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
								</div>
								<div class="modal-body">
									Are you sure you want to delete this department?
								</div>
								<div class="modal-footer">
									<form id="deleteDepartmentForm" method="post" action="/Department/Delete">
										<input type="hidden" name="id" id="deleteDeptId" />
										<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
										<button type="submit" class="btn btn-danger">Delete</button>
									</form>
								</div>
							</div>
						</div>
					</div>

				 </tbody>
			</table>
		</div>
	</div>


}
else
{
	<div class="alert alert-primary mt-4">
		<p>There is No Departments</p>
	</div>
}
<br />
<a asp-controller="Department" asp-action="Create" class="btn btn-outline-primary">Create New Department</a>
<br />
@section Scripts {
	<script src="~/js/deleteCustomModal.js" asp-asp-append-version="true"></script>
}